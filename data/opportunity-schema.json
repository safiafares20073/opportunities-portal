{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OpportunitiesDataset",
  "description": "Schema for Opportunities Portal datasets containing scholarships, courses, and internships.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "title_ar",
      "title_en",
      "organization",
      "category",
      "field",
      "country",
      "coverage",
      "deadline",
      "official_url",
      "verification_date",
      "eligibility_ar",
      "eligibility_en"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$",
        "description": "Unique URL-friendly slug identifier (e.g., chevening-scholarship-2026)"
      },
      "title_ar": {
        "type": "string",
        "minLength": 3,
        "description": "Opportunity title in Arabic"
      },
      "title_en": {
        "type": "string",
        "minLength": 3,
        "description": "Opportunity title in English"
      },
      "organization": {
        "type": "string",
        "minLength": 2,
        "description": "Offering institution, university, or organization"
      },
      "category": {
        "type": "string",
        "enum": ["Scholarship", "Course", "Internship"],
        "description": "Category of the opportunity"
      },
      "field": {
        "type": "string",
        "minLength": 2,
        "description": "Academic or professional field (e.g., Computer Science, Engineering, Medicine)"
      },
      "country": {
        "type": "string",
        "minLength": 2,
        "description": "Destination country or 'Online'"
      },
      "coverage": {
        "type": "string",
        "minLength": 2,
        "description": "Financial coverage or cost (e.g., Fully Funded, Partially Funded, Free with Certificate)"
      },
      "deadline": {
        "type": "string",
        "pattern": "^(\\d{4}-\\d{2}-\\d{2}|Rolling)$",
        "description": "Application deadline in ISO format (YYYY-MM-DD) or 'Rolling'"
      },
      "official_url": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://.+",
        "description": "Official institutional application or announcement URL (must be HTTPS)"
      },
      "verification_date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "Manual verification date in ISO format (YYYY-MM-DD)"
      },
      "eligibility_ar": {
        "type": "string",
        "minLength": 10,
        "description": "Key eligibility criteria in Arabic"
      },
      "eligibility_en": {
        "type": "string",
        "minLength": 10,
        "description": "Key eligibility criteria in English"
      }
    },
    "additionalProperties": false
  }
}
